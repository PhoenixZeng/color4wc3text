{
  "name": "color4wc3text",
  "displayName": "ColorPicker颜色选择器",
  "version": "1.0.0",
  "description": "ColorPicker颜色选择器,也支持一些常用格式",
  "categories": [
    "Other"
  ],
  "keywords": [
    "color",
    "color picker",
    "colour",
    "colour picker",
    "war3",
    "warcraft",
    "wc3"
  ],
  "homepage": "https://github.com/PhoenixZeng/color4wc3text/blob/master/README.md",
  "bugs": {
    "url": "https://github.com/PhoenixZeng/color4wc3text/issues"
  },
  "license": "Apache License Version 2.0",
  "author": "PhoenixZeng",
  "repository": {
    "type": "git",
    "url": "https://github.com/PhoenixZeng/color4wc3text.git"
  },
  "publisher": "PhoenixZeng",
  "main": "./out/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "test": "vscode-test",
    "publish": "vsce publish",
    "pubpatch": "vsce publish patch",
    "package": "vsce package",
    "lint": "oxlint src"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.6",
    "@types/vscode": "^1.137.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "typescript": "^6.0.3"
  },
  "contributes": {
    "configuration": {
      "title": "ColorPicker 颜色选择器",
      "properties": {
        "color4wc3text.hexCase": {
          "type": "string",
          "enum": [
            "uppercase",
            "lowercase",
            "auto"
          ],
          "enumItemLabels": [
            "大写",
            "小写",
            "自动"
          ],
          "default": "auto",
          "scope": "resource",
          "enumDescriptions": [
            "将颜色代码中的 A–F 输出为大写。",
            "将颜色代码中的 A–F 输出为小写。",
            "按目标颜色代码从左侧找到的第一个 A–F 字母判断大小写；纯数字采用大写。"
          ],
          "description": "War3 和 CSS HEX 颜色回写的大小写，不改变 War3 前缀或正文。"
        },
        "color4wc3text.floatPrecision": {
          "type": "integer",
          "default": 3,
          "minimum": 0,
          "maximum": 20,
          "scope": "resource",
          "description": "RGBA 透明度回写的小数精度。按指定小数位数四舍五入并移除末尾无意义的 0；默认 3 位，例如 0.1236 → 0.124、0.0004 → 0、0.4 → 0.4。"
        }
      }
    }
  },
  "activationEvents": [
    "onLanguage:css",
    "onLanguage:fdf",
    "onLanguage:html",
    "onLanguage:ini",
    "onLanguage:jass",
    "onLanguage:javascript",
    "onLanguage:json",
    "onLanguage:lua",
    "onLanguage:typescript",
    "onLanguage:vjass",
    "onLanguage:xml",
    "onLanguage:zinc"
  ],
  "icon": "resource/icon.png",
  "markdown": "github",
  "engines": {
    "vscode": "^1.137.0"
  },
  "overrides": {
    "mocha": "^12.0.3",
    "glob": "^14.0.4",
    "minimatch": "^11.0.5"
  }
}
